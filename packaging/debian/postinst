#!/bin/sh
set -e

if ! getent group audiobookshelf >/dev/null 2>&1; then
  addgroup --system audiobookshelf >/dev/null
fi
if ! getent passwd audiobookshelf >/dev/null 2>&1; then
  adduser --system --ingroup audiobookshelf --home /var/lib/audiobookshelf \
    --no-create-home --disabled-login --disabled-password audiobookshelf >/dev/null
fi

install -d -o audiobookshelf -g audiobookshelf -m 0750 \
  /var/lib/audiobookshelf \
  /var/lib/audiobookshelf/config \
  /var/lib/audiobookshelf/metadata

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
  systemctl enable audiobookshelf.service >/dev/null 2>&1 || true
  if [ "$1" = "configure" ]; then
    systemctl restart audiobookshelf.service >/dev/null 2>&1 || true
  fi
fi

exit 0
